# ---------------------------------------------------------------------------
# Build products of this project.  Everything here is regenerated by ./build.sh
# and must never be committed.
# ---------------------------------------------------------------------------
/build/
/dist/
/.cache/

# configure leaves these behind when a build is run inside the source tree,
# which the scripts never do but a developer experimenting by hand might.
/config.log
/config.status

# Compiler and linker intermediates, for out-of-tree experiments too.
*.o
*.a
*.dylib
*.so
*.dSYM/
*.dSYM.zip

# ---------------------------------------------------------------------------
# Logs, crash dumps and patch leftovers.  These appear on any platform.
# ---------------------------------------------------------------------------
*.log
core
core.*
*.core
*.stackdump
*.orig
*.rej
.gdb_history

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
.fseventsd/
__MACOSX/

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# Linux desktop environments
# ---------------------------------------------------------------------------
.directory
.Trash-*
*.kate-swp

# ---------------------------------------------------------------------------
# Editors and IDEs.  Keep the list to state that is local to one machine; any
# shared configuration belongs in the repository.
# ---------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
.history/
*.swp
*.swo
*~
.project
.classpath
.settings/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.cache/clangd/

# ---------------------------------------------------------------------------
# Python tooling, for contributors who keep helper scripts around.
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
