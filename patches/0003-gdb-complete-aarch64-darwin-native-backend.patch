+/* The Apple ARM64 signal trampoline passes the ucontext pointer in x4
+   before calling the user handler.  The mcontext contains the same ARM
+   thread-state and NEON layouts used by thread_get_state.  */
+
+static CORE_ADDR
+aarch64_darwin_signal_mcontext (const frame_info_ptr &this_frame)
+{
+  struct gdbarch *gdbarch = get_frame_arch (this_frame);
+  enum bfd_endian byte_order = gdbarch_byte_order (gdbarch);
+  CORE_ADDR ucontext
+    = get_frame_register_unsigned (this_frame, AARCH64_X0_REGNUM + 4);
+  gdb_byte buf[8];
+
+  if (target_read_memory
+      (ucontext + offsetof (DARWIN_UCONTEXT64_TYPE, uc_mcontext64),
+	       buf, sizeof buf))
+    error (_("Unable to read Darwin ARM64 signal context"));
+
+  return extract_unsigned_integer (buf, sizeof buf, byte_order);
+}
+
+static void
+aarch64_darwin_sigframe_init (const struct tramp_frame *self,
+			      const frame_info_ptr &this_frame,
+			      struct trad_frame_cache *cache,
+			      CORE_ADDR func)
+{
+  struct gdbarch *gdbarch = get_frame_arch (this_frame);
+  enum bfd_endian byte_order = gdbarch_byte_order (gdbarch);
+  CORE_ADDR mcontext = aarch64_darwin_signal_mcontext (this_frame);
+  CORE_ADDR thread_state
+    = mcontext + offsetof (_STRUCT_MCONTEXT64,
+				   DARWIN_ARM64_MCONTEXT_SS_MEMBER);
+  CORE_ADDR neon_state
+    = mcontext + offsetof (_STRUCT_MCONTEXT64,
+				   DARWIN_ARM64_MCONTEXT_NS_MEMBER);
+
+  for (int i = 0; i < 29; ++i)
+    trad_frame_set_reg_addr (cache, AARCH64_X0_REGNUM + i,
+				     thread_state + i * 8);
+
+  trad_frame_set_reg_addr
+    (cache, AARCH64_FP_REGNUM,
+     thread_state + offsetof (arm_thread_state64_t,
+				      DARWIN_ARM64_THREAD_FP_MEMBER));
+  trad_frame_set_reg_addr
+    (cache, AARCH64_LR_REGNUM,
+     thread_state + offsetof (arm_thread_state64_t,
+				      DARWIN_ARM64_THREAD_LR_MEMBER));
+  trad_frame_set_reg_addr
+    (cache, AARCH64_SP_REGNUM,
+     thread_state + offsetof (arm_thread_state64_t,
+				      DARWIN_ARM64_THREAD_SP_MEMBER));
+  trad_frame_set_reg_addr
+    (cache, AARCH64_PC_REGNUM,
+     thread_state + offsetof (arm_thread_state64_t,
+				      DARWIN_ARM64_THREAD_PC_MEMBER));
+  trad_frame_set_reg_addr
+    (cache, AARCH64_CPSR_REGNUM,
+     thread_state + offsetof (arm_thread_state64_t,
+				      DARWIN_ARM64_THREAD_CPSR_MEMBER));
+
+  for (int i = 0; i < 32; ++i)
+    trad_frame_set_reg_addr (cache, AARCH64_V0_REGNUM + i,
+				     neon_state + i * 16);
+  trad_frame_set_reg_addr
+    (cache, AARCH64_FPSR_REGNUM,
+     neon_state + 32 * 16);
+  trad_frame_set_reg_addr
+    (cache, AARCH64_FPCR_REGNUM,
+     neon_state + 32 * 16 + sizeof (uint32_t));
+
+  CORE_ADDR sp = get_frame_register_unsigned (this_frame, AARCH64_SP_REGNUM);
+  trad_frame_set_id (cache, frame_id_build (sp, func));
+}
+
+static int
+aarch64_darwin_sigtramp_validate (const struct tramp_frame *self,
+				  const frame_info_ptr &this_frame,
+				  CORE_ADDR *pc)
+{
+  const char *name = nullptr;
+  CORE_ADDR start = 0;
+
+  if (!find_pc_partial_function (*pc, &name, &start, nullptr)
+      || name == nullptr
+      || (strcmp (name, "_sigtramp") != 0
+		  && strcmp (name, "__sigtramp") != 0))
+    return 0;
+
+  *pc = start;
+  return 1;
+}
