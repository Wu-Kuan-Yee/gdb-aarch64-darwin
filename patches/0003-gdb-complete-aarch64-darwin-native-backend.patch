+       deliberately avoids tying this code to one SDK's trampoline body.  */
+    {0, 0},
+    {TRAMP_SENTINEL_INSN, 0}
+  },
+  aarch64_darwin_sigframe_init,
+  aarch64_darwin_sigtramp_validate
+};
 
