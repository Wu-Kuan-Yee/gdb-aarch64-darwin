diff --git a/gdb/README b/gdb/README
index 492b0891668..88e5edc3b09 100644
--- a/gdb/README
+++ b/gdb/README
@@ -97,6 +97,41 @@ section of this README.
 type while debugging a program running on a machine of another type.
 See below.
 
+macOS Darwin native target signing
+==================================
+
+   On macOS, the native Darwin target obtains the inferior's Mach task port
+   through task_for_pid.  Configure GDB with a trusted development signing
+   identity so that --enable-codesign adds the Hardened Runtime and the
+   com.apple.security.cs.debugger entitlement:
+
+      <source-dir>/gdb/configure --enable-codesign="Apple Development: ..."
+      make -C <build-dir>/gdb gdb
+
+   The inferior must also opt in to debugging.  A normal /usr/bin/cc -g link
+   does not add com.apple.security.get-task-allow.  For a local development
+   build, sign the resulting executable with an Apple Development identity
+   and an entitlements file containing:
+
+      <?xml version="1.0" encoding="UTF-8"?>
+      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
+        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+      <plist version="1.0"><dict>
+        <key>com.apple.security.get-task-allow</key><true/>
+      </dict></plist>
+
+   Apply it after every rebuild, for example:
+
+      codesign --force --options runtime \
+        --entitlements inferior.entitlements \
+        --sign "Apple Development: ..." ./program
+
+   Check both sides before running GDB:
+
+      security find-identity -v -p codesigning
+      codesign -d --entitlements :- <path-to-gdb>
+      codesign -d --entitlements :- <path-to-inferior>
+
 
 More Documentation
 ******************
diff --git a/gdb/darwin-nat.c b/gdb/darwin-nat.c
index 8728b4653de..598f8943af4 100644
--- a/gdb/darwin-nat.c
+++ b/gdb/darwin-nat.c
@@ -136,8 +136,12 @@ static unsigned int darwin_debug_flag = 0;
 /* Create a __TEXT __info_plist section in the executable so that gdb could
    be signed.  This is required to get an authorization for task_for_pid.
 
-   Once gdb is built, you must codesign it with any system-trusted signing
-   authority.  See taskgated(8) for details.  */
+   Once gdb is built, it must be signed with a system-trusted signing
+   authority and the com.apple.security.cs.debugger entitlement.  The
+   --enable-codesign configure option supplies that entitlement automatically.
+   The inferior must separately be signed with
+   com.apple.security.get-task-allow; a plain /usr/bin/cc -g build does not
+   acquire that entitlement.  See taskgated(8) for details.  */
 static const unsigned char info_plist[]
 __attribute__ ((section ("__TEXT,__info_plist"),used)) =
   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
diff --git a/gdb/gdb-debugger.entitlements b/gdb/gdb-debugger.entitlements
new file mode 100644
index 00000000000..871618bde2e
--- /dev/null
