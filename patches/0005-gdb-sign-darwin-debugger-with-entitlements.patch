diff --git a/gdb/Makefile.in b/gdb/Makefile.in
index eda40466ec3..1f284732614 100644
--- a/gdb/Makefile.in
+++ b/gdb/Makefile.in
@@ -242,6 +242,7 @@ GDB_DATADIR = @GDB_DATADIR@
 # Code signing.
 CODESIGN = codesign
 CODESIGN_CERT = @CODESIGN_CERT@
+CODESIGN_ENTITLEMENTS = $(srcdir)/gdb-debugger.entitlements
 
 # Flags to pass to gdb when invoked with "make run".
 GDBFLAGS =
@@ -2371,13 +2372,15 @@ libgdb.a: $(LIBGDB_OBS)
 	$(RANLIB) libgdb.a
 
 # Removing the old gdb first works better if it is running, at least on SunOS.
-gdb$(EXEEXT): gdb.o $(LIBGDB_OBS) $(CDEPS) $(TDEPLIBS)
+gdb$(EXEEXT): gdb.o $(LIBGDB_OBS) $(CDEPS) $(TDEPLIBS) \
+	$(CODESIGN_ENTITLEMENTS)
 	$(SILENCE) rm -f gdb$(EXEEXT)
 	$(ECHO_CXXLD) $(CC_LD) $(INTERNAL_LDFLAGS) $(WIN32LDAPP) \
 		-o gdb$(EXEEXT) gdb.o $(LIBGDB_OBS) \
 		$(TDEPLIBS) $(TUI_LIBRARY) $(CLIBS) $(LOADLIBES)
 ifneq ($(CODESIGN_CERT),)
-	$(ECHO_SIGN) $(CODESIGN) -s $(CODESIGN_CERT) gdb$(EXEEXT)
+	$(ECHO_SIGN) $(CODESIGN) -s $(CODESIGN_CERT) --options runtime \
+		--entitlements $(CODESIGN_ENTITLEMENTS) gdb$(EXEEXT)
 endif
 
 # This is useful when debugging GDB, because some Unix's don't let you run GDB
