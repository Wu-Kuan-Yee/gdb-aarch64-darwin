diff --git a/gdb/darwin-nat.c b/gdb/darwin-nat.c
--- a/gdb/darwin-nat.c
+++ b/gdb/darwin-nat.c
@@ -63,6 +63,7 @@
 #include <mach/port.h>
 
 #include "darwin-nat.h"
+#include "solib-darwin.h"
 #include "filenames.h"
 #include "gdbsupport/filestuff.h"
 #include "gdbsupport/gdb_unlinker.h"
@@ -1331,7 +1332,25 @@
 darwin_nat_target::wait (ptid_t ptid, struct target_waitstatus *status,
 			 target_wait_flags options)
 {
-  return wait_1 (ptid, status);
+  struct inferior *inf = current_inferior ();
+  darwin_inferior *priv = get_darwin_inferior (inf);
+
+  ptid_t res = wait_1 (ptid, status);
+
+  /* At the initial exec stop dyld has not built its image list yet, so the
+     solib hook runs before any library is visible.  Once a later stop
+     arrives, dyld is up: load the libraries now, while the inferior is
+     stopped, and install the notifier that reports later loads.  */
+  if (!priv->solib_events_reported
+      && status->kind () == TARGET_WAITKIND_STOPPED
+      && darwin_solib_refresh ())
+    {
+      priv->solib_events_reported = true;
+      darwin_solib_install_notifier ();
+      solib_add (nullptr, 0, 1);
+    }
+
+  return res;
 }
 
