 }
 
 /* Read dyld_all_image from inferior.  */
@@ -269,6 +270,12 @@
       if (file_path == nullptr)
 	break;
 
+      /* Libraries that live only in the dyld shared cache have no file on
+	 disk: GDB cannot read their symbols, and trying to open one would
+	 report an error for every library in the process.  Skip them.  */
+      if (access (file_path.get (), R_OK) != 0)
+	continue;
+
       /* Create and fill the new struct solib element.  */
       sos.emplace_back (std::make_unique<lm_info_darwin> (load_addr),
 			file_path.get (), file_path.get (), *this);
@@ -498,6 +505,11 @@
       return;
     }
 
+  if (info->all_image.version > DYLD_VERSION_MAX)
+    warning (_("dyld version %d is newer than the known maximum %d; "
+	       "shared library support may be incomplete"),
+	     info->all_image.version, DYLD_VERSION_MAX);
+
   if (info->all_image.count != 0)
     {
       /* Possible relocate the main executable (PIE).  */
@@ -566,12 +578,45 @@
     }
 
   /* Add the breakpoint which is hit by dyld when the list of solib is
-     modified.  */
-  if (notifier != 0)
+     modified.  When dyld has not published its image list yet the notifier
+     field is not meaningful; the breakpoint is installed later, from
+     darwin_solib_install_notifier, once the list is available.  */
+  if (notifier != 0 && info->all_image.count != 0)
     create_solib_event_breakpoint (current_inferior ()->arch (), notifier);
 }
 
+/* See solib-darwin.h.  */
+
+bool
+darwin_solib_refresh ()
+{
+  if (!target_has_execution ())
+    return false;
+
+  darwin_info *info = get_darwin_info (current_program_space);
+
+  info->all_image_addr = 0;
+  darwin_solib_read_all_image_info_addr (info);
+  if (info->all_image_addr == 0)
+    return false;
+
+  darwin_load_image_infos (info);
+  return info->all_image.count != 0;
+}
+
+/* See solib-darwin.h.  */
+
 void
+darwin_solib_install_notifier ()
+{
+  darwin_info *info = get_darwin_info (current_program_space);
+
+  if (info->all_image.notifier != 0)
+    create_solib_event_breakpoint (current_inferior ()->arch (),
+				   info->all_image.notifier);
+}
+
+void
 darwin_solib_ops::clear_solib (program_space *pspace) const
 {
   darwin_info *info = get_darwin_info (pspace);
