+/* Return true when ADDR looks like the Darwin ucontext_t that the kernel
+   builds for a signal handler: the mcontext pointer has to be readable and
+   the saved stack pointer and program counter have to be plausible.  */
+
+static int
+aarch64_darwin_ucontext_p (CORE_ADDR ucontext)
+{
+  struct gdbarch *gdbarch = current_inferior ()->arch ();
+  enum bfd_endian byte_order = gdbarch_byte_order (gdbarch);
+  gdb_byte buf[8];
+  CORE_ADDR mcontext;
+  CORE_ADDR thread_state;
+  CORE_ADDR sp;
+  CORE_ADDR pc;
+
+  if (ucontext == 0)
+    return 0;
+
+  if (target_read_memory
+      (ucontext + offsetof (DARWIN_UCONTEXT64_TYPE, uc_mcontext64),
+       buf, sizeof buf))
+    return 0;
+
+  mcontext = extract_unsigned_integer (buf, sizeof buf, byte_order);
+  if (mcontext == 0)
+    return 0;
+
+  thread_state = mcontext + offsetof (_STRUCT_MCONTEXT64,
+				      DARWIN_ARM64_MCONTEXT_SS_MEMBER);
+
+  if (target_read_memory
+      (thread_state + offsetof (arm_thread_state64_t,
+				DARWIN_ARM64_THREAD_SP_MEMBER),
+       buf, sizeof buf))
+    return 0;
+  sp = extract_unsigned_integer (buf, sizeof buf, byte_order);
+
+  if (target_read_memory
+      (thread_state + offsetof (arm_thread_state64_t,
+				DARWIN_ARM64_THREAD_PC_MEMBER),
+       buf, sizeof buf))
+    return 0;
+  pc = extract_unsigned_integer (buf, sizeof buf, byte_order);
+
+  return sp != 0 && (sp & 0xf) == 0 && pc != 0;
+}
