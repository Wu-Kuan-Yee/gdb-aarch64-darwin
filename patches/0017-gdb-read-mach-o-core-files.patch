+/* Open a Mach-O core file as the current target.  Returns false when the
+   file is not a Mach-O core, leaving the current target untouched.  */
+
+bool
+darwin_core_open (const char *filename, int from_tty)
+{
+  int fd = open (filename, O_RDONLY);
+  if (fd < 0)
+    return false;
+
+  struct stat st;
+  if (fstat (fd, &st) != 0 || st.st_size < 32)
+    {
+      close (fd);
+      return false;
+    }
+
+  void *map = mmap (nullptr, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+  close (fd);
+  if (map == MAP_FAILED)
+    return false;
+
+  const gdb_byte *data = (const gdb_byte *) map;
+  size_t size = st.st_size;
+
+  auto rd32 = [&] (size_t off)
+    {
+      return (uint32_t) data[off]
+	     | ((uint32_t) data[off + 1] << 8)
+	     | ((uint32_t) data[off + 2] << 16)
+	     | ((uint32_t) data[off + 3] << 24);
+    };
+  auto rd64 = [&] (size_t off)
+    {
+      return (uint64_t) rd32 (off) | ((uint64_t) rd32 (off + 4) << 32);
+    };
+
+  if (rd32 (0) != 0xfeedfacf || rd32 (12) != 4)
+    {
+      munmap (map, st.st_size);
+      return false;
+    }
+
+  uint32_t ncmds = rd32 (16);
+  uint32_t sizeofcmds = rd32 (20);
+  if (32 + sizeofcmds > size)
+    {
+      munmap (map, st.st_size);
+      return false;
+    }
+
+  std::vector<darwin_core_segment> segments;
+  std::vector<darwin_core_thread> threads;
+
+  size_t off = 32;
+  for (uint32_t i = 0; i < ncmds && off + 8 <= 32 + sizeofcmds; i++)
+    {
+      uint32_t cmd = rd32 (off);
+      uint32_t cmdsize = rd32 (off + 4);
+      if (cmdsize < 8 || off + cmdsize > size)
+	break;
+
+      if (cmd == 0x19 && cmdsize >= 72)		/* LC_SEGMENT_64 */
+	{
+	  darwin_core_segment seg;
+	  seg.addr = rd64 (off + 24);
+	  seg.size = rd64 (off + 32);
+	  seg.fileoff = rd64 (off + 40);
+	  seg.filesize = rd64 (off + 48);
+	  if (seg.fileoff + seg.filesize <= size && seg.size != 0)
+	    segments.push_back (seg);
+	}
+      else if ((cmd == 0x4 || cmd == 0x5) && cmdsize >= 16)	/* thread */
+	{
+	  uint32_t flavor = rd32 (off + 8);
+	  uint32_t count = rd32 (off + 12);
+	  if (flavor == 6 && count >= 68 && off + 16 + 272 <= size)
+	    {
+	      darwin_core_thread th {};
+	      size_t p = off + 16;
+	      for (int r = 0; r < 29; r++, p += 8)
+		th.x[r] = rd64 (p);
+	      th.fp = rd64 (p); p += 8;
+	      th.lr = rd64 (p); p += 8;
+	      th.sp = rd64 (p); p += 8;
+	      th.pc = rd64 (p); p += 8;
+	      th.cpsr = rd32 (p);
+	      threads.push_back (th);
+	    }
+	}
+      off += cmdsize;
+    }
+
+  if (segments.empty () || threads.empty ())
+    {
+      munmap (map, st.st_size);
+      return false;
+    }
+
+  if (current_program_space->exec_bfd () == nullptr)
+    error (_("Load the executable before opening a Mach-O core file."));
+
+  target_preopen (from_tty);
+  switch_to_no_thread ();
+  registers_changed ();
+
+  const int pid = 1;
+  size_t nthreads = threads.size ();
+  auto holder = target_ops_up
+    (new darwin_core_target (data, size, std::move (segments),
+			     std::move (threads), pid));
+  current_inferior ()->push_target (std::move (holder));
+
+  inferior *inf = current_inferior ();
+  inferior_appeared (inf, pid);
+  inf->fake_pid_p = true;
+
+  for (size_t i = 0; i < nthreads; i++)
+    add_thread_silent (inf->process_target (), ptid_t (pid, 0, i + 1));
+
+  struct thread_info *first = first_thread_of_inferior (inf);
+  if (first != nullptr)
+    switch_to_thread (first);
+
+  gdb_printf (_("Core file '%s' loaded (Mach-O, %zu threads).\n"),
+	      filename, nthreads);
+  return true;
+}
