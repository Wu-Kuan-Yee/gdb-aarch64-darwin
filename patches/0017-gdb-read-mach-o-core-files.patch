+namespace {
+
+struct darwin_core_segment
+{
+  uint64_t addr;
+  uint64_t size;
+  uint64_t fileoff;
+  uint64_t filesize;
+};
+
+struct darwin_core_thread
+{
+  uint64_t x[29];
+  uint64_t fp;
+  uint64_t lr;
+  uint64_t sp;
+  uint64_t pc;
+  uint32_t cpsr;
+};
+
+static const target_info darwin_core_target_info = {
+  "darwin-core",
+  N_("Darwin Mach-O core file"),
+  N_("Use a Mach-O core file as a target.")
+};
+
+class darwin_core_target final : public process_stratum_target
+{
+public:
+  darwin_core_target (const gdb_byte *data, size_t size,
+		      std::vector<darwin_core_segment> &&segments,
+		      std::vector<darwin_core_thread> &&threads, int pid)
+    : m_data (data), m_size (size), m_segments (std::move (segments)),
+      m_threads (std::move (threads)), m_pid (pid)
+  {}
+
+  const target_info &info () const override
+  { return darwin_core_target_info; }
+
+  void close () override {}
+  void detach (inferior *, int) override {}
+
+  bool has_all_memory () override { return true; }
+  bool has_memory () override { return true; }
+  bool has_stack () override { return true; }
+  bool has_registers () override { return true; }
+  bool has_execution (inferior *) override { return false; }
+
+  bool thread_alive (ptid_t ptid) override
+  {
+    return ptid.pid () == m_pid
+	   && ptid.tid () > 0
+	   && (size_t) ptid.tid () <= m_threads.size ();
+  }
+
+  void fetch_registers (struct regcache *regcache, int regno) override;
+  enum target_xfer_status xfer_partial (enum target_object object,
+					const char *annex,
+					gdb_byte *readbuf,
+					const gdb_byte *writebuf,
+					ULONGEST offset, ULONGEST len,
+					ULONGEST *xfered_len) override;
+
+private:
+  const gdb_byte *m_data;
+  size_t m_size;
+  std::vector<darwin_core_segment> m_segments;
+  std::vector<darwin_core_thread> m_threads;
+  int m_pid;
+};
+
+static int
+darwin_core_regnum (struct gdbarch *gdbarch, const char *name)
+{
+  for (int r = 0; r < gdbarch_num_regs (gdbarch); r++)
+    {
+      const char *rn = gdbarch_register_name (gdbarch, r);
+      if (rn != nullptr && strcmp (rn, name) == 0)
+	return r;
+    }
+  return -1;
+}
+
+void
+darwin_core_target::fetch_registers (struct regcache *regcache, int regno)
+{
+  struct gdbarch *gdbarch = regcache->arch ();
+  int tid = inferior_thread ()->ptid.tid ();
+  if (tid <= 0 || (size_t) tid > m_threads.size ())
+    return;
+
+  const darwin_core_thread &st = m_threads[tid - 1];
+
+  auto supply = [&] (const char *name, const void *value)
+    {
+      int r = darwin_core_regnum (gdbarch, name);
+      if (r >= 0 && (regno == -1 || regno == r))
+	regcache->raw_supply (r, value);
+    };
+
+  char name[8];
+  for (int i = 0; i < 29; i++)
+    {
+      xsnprintf (name, sizeof (name), "x%d", i);
+      supply (name, &st.x[i]);
+    }
+  supply ("x29", &st.fp);
+  supply ("x30", &st.lr);
+  supply ("sp", &st.sp);
+  supply ("pc", &st.pc);
+  supply ("cpsr", &st.cpsr);
+}
+
+enum target_xfer_status
+darwin_core_target::xfer_partial (enum target_object object,
+				  const char *annex,
+				  gdb_byte *readbuf,
+				  const gdb_byte *writebuf,
+				  ULONGEST offset, ULONGEST len,
+				  ULONGEST *xfered_len)
+{
+  if (object != TARGET_OBJECT_MEMORY || writebuf != nullptr)
+    return TARGET_XFER_E_IO;
+
+  for (const darwin_core_segment &seg : m_segments)
+    {
+      if (offset < seg.addr || offset >= seg.addr + seg.size)
+	continue;
+
+      ULONGEST seg_off = offset - seg.addr;
+      ULONGEST n = std::min (len, seg.size - seg_off);
+      if (seg_off + n > seg.filesize)
+	n = seg.filesize - seg_off;
+      if (n == 0)
+	return TARGET_XFER_E_IO;
+
+      memcpy (readbuf, m_data + seg.fileoff + seg_off, n);
+      *xfered_len = n;
+      return TARGET_XFER_OK;
+    }
+
+  return TARGET_XFER_E_IO;
+}
