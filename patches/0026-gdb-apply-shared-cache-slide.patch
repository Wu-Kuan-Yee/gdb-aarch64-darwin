+
+/* Runtime slide of the shared cache: find the mapped cache header by
+   its magic; its unslid address is the shared region base.  */
+
+static uint64_t
+darwin_shcache_slide (const darwin_dsc_state &state)
+{
+  inferior *inf = current_inferior ();
+  darwin_inferior *priv = get_darwin_inferior (inf);
+  if (priv->task == MACH_PORT_NULL || inf->pid == 0)
+    return 0;
+
+  mach_vm_address_t addr = 0;
+  while (true)
+    {
+      mach_vm_size_t size = 0;
+      vm_region_basic_info_data_64_t info;
+      mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+      mach_port_t object_name = MACH_PORT_NULL;
+      kern_return_t kret
+	= mach_vm_region (priv->task, &addr, &size, VM_REGION_BASIC_INFO_64,
+			  (vm_region_info_t) &info, &count, &object_name);
+      if (kret != KERN_SUCCESS)
+	break;
+
+      if ((info.protection & VM_PROT_READ) != 0 && size >= 16)
+	{
+	  gdb_byte magic[16];
+	  if (target_read_memory (addr, magic, sizeof (magic)) == 0
+	      && memcmp (magic, "dyld_v1", 7) == 0)
+	    return addr - 0x180000000;
+	}
+
+      addr += size;
+    }
+
+  return 0;
+}
