+/* Description of one image for the self-describing core notes.  */
+
+struct darwin_core_image
+{
+  std::string path;
+  uint64_t load = 0;
+  uint32_t filetype = 0;
+  uint64_t text_vmaddr = 0;
+  uint8_t uuid[16] = {};
+  std::vector<std::pair<std::string, uint64_t>> segments;
+};
+
+static uint32_t
+darwin_core_u32 (const gdb_byte *p)
+{
+  return (uint32_t) p[0] | ((uint32_t) p[1] << 8)
+	 | ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24);
+}
+
+static uint64_t
+darwin_core_u64 (const gdb_byte *p)
+{
+  return (uint64_t) darwin_core_u32 (p)
+	 | ((uint64_t) darwin_core_u32 (p + 4) << 32);
+}
+
+/* Read the load commands of the image at LOAD and fill CI.  */
+
+static bool
+darwin_core_read_image (uint64_t load, darwin_core_image *ci)
+{
+  gdb_byte hdr[32];
+  if (target_read_memory (load, hdr, sizeof (hdr)) != 0
+      || darwin_core_u32 (hdr) != 0xfeedfacf)
+    return false;
+
+  ci->load = load;
+  ci->filetype = darwin_core_u32 (hdr + 12);
+  uint32_t ncmds = darwin_core_u32 (hdr + 16);
+  uint32_t sizeofcmds = darwin_core_u32 (hdr + 20);
+  if (sizeofcmds > (1u << 20))
+    return false;
+
+  std::vector<gdb_byte> cmds (sizeofcmds);
+  if (sizeofcmds != 0
+      && target_read_memory (load + 32, cmds.data (), sizeofcmds) != 0)
+    return false;
+
+  size_t off = 0;
+  for (uint32_t i = 0; i < ncmds && off + 8 <= cmds.size (); i++)
+    {
+      uint32_t cmd = darwin_core_u32 (&cmds[off]);
+      uint32_t size = darwin_core_u32 (&cmds[off + 4]);
+      if (size < 8 || off + size > cmds.size ())
+	break;
+
+      if (cmd == 0x19 && size >= 72)	/* LC_SEGMENT_64 */
+	{
+	  char segname[17] = {};
+	  memcpy (segname, &cmds[off + 8], 16);
+	  uint64_t vmaddr = darwin_core_u64 (&cmds[off + 24]);
+	  ci->segments.emplace_back (segname, vmaddr);
+	  if (strcmp (segname, "__TEXT") == 0)
+	    ci->text_vmaddr = vmaddr;
+	}
+      else if (cmd == 0x1b && size >= 24)	/* LC_UUID */
+	memcpy (ci->uuid, &cmds[off + 8], 16);
+
+      off += size;
+    }
+
+  return true;
+}
