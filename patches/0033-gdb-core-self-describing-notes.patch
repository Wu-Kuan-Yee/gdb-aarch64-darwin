+
+/* See solib-darwin.h.  */
+
+bool
+darwin_solib_get_all_images
+  (std::vector<std::pair<CORE_ADDR, std::string>> &images)
+{
+  type *ptr_type
+    = builtin_type (current_inferior ()->arch ())->builtin_data_ptr;
+  int ptr_len = ptr_type->length ();
+  unsigned int image_info_size = ptr_len * 3;
+  darwin_info *info = get_darwin_info (current_program_space);
+
+  darwin_load_image_infos (info);
+  if (!darwin_dyld_version_ok (info))
+    return false;
+
+  for (int i = 0; i < info->all_image.count; i++)
+    {
+      CORE_ADDR iinfo = info->all_image.info + i * image_info_size;
+      gdb::byte_vector buf (image_info_size);
+      if (target_read_memory (iinfo, buf.data (), image_info_size))
+	break;
+
+      CORE_ADDR load_addr = extract_typed_address (buf.data (), ptr_type);
+      CORE_ADDR path_addr
+	= extract_typed_address (buf.data () + ptr_len, ptr_type);
+      gdb::unique_xmalloc_ptr<char> path
+	= target_read_string (path_addr, SO_NAME_MAX_PATH_SIZE - 1);
+      if (path == nullptr)
+	continue;
+      images.emplace_back (load_addr, path.get ());
+    }
+
+  return true;
+}
