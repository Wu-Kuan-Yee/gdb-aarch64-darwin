+	    {
+	      const char *path = (const char *) data + note_off + 48;
+	      size_t max = note_size - 48;
+	      size_t len = strnlen (path, max);
+	      if (len != 0 && len < max)
+		main_path.assign (path, len);
+	    }
+	}
       else if ((cmd == 0x4 || cmd == 0x5) && cmdsize >= 16)	/* thread */
 	{
 	  uint32_t flavor = rd32 (off + 8);
@@ -1627,7 +1646,11 @@ darwin_core_open (const char *filename, int from_tty)
     }
 
   if (current_program_space->exec_bfd () == nullptr)
-    error (_("Load the executable before opening a Mach-O core file."));
