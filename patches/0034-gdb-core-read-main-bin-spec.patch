diff --git a/gdb/darwin-nat.c b/gdb/darwin-nat.c
index 5da115b7fdc..e7745642ed3 100644
--- a/gdb/darwin-nat.c
+++ b/gdb/darwin-nat.c
@@ -28,6 +28,7 @@
 #include "cli/cli-cmds.h"
 #include "cli/cli-style.h"
 #include "gdbcore.h"
+#include "exec.h"
 #include "gdbthread.h"
 #include "regcache.h"
 #include "thread-iter.h"
@@ -1580,6 +1581,7 @@ darwin_core_open (const char *filename, int from_tty)
 
   std::vector<darwin_core_segment> segments;
   std::vector<darwin_core_thread> threads;
+  std::string main_path;
 
   size_t off = 32;
   for (uint32_t i = 0; i < ncmds && off + 8 <= 32 + sizeofcmds; i++)
@@ -1599,6 +1601,23 @@ darwin_core_open (const char *filename, int from_tty)
 	  if (seg.fileoff + seg.filesize <= size && seg.size != 0)
 	    segments.push_back (seg);
 	}
+      else if (cmd == 0x31 && cmdsize >= 40)		/* LC_NOTE */
+	{
+	  char owner[17] = {};
+	  memcpy (owner, data + off + 8, 16);
+	  uint64_t note_off = rd64 (off + 24);
+	  uint64_t note_size = rd64 (off + 32);
+	  if (strcmp (owner, "main bin spec") == 0
+	      && note_off <= size && note_size <= size - note_off
