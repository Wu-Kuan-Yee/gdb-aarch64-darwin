+static void
+darwin_shared_sections_command (const char *args, int from_tty)
+{
+  if (args == nullptr || *args == '\0')
+    error (_("usage: darwin-shared-sections PATH-FILTER"));
+
+  darwin_dsc_state state;
+  std::string base
+    = "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld/"
+      "dyld_shared_cache_arm64e";
+  if (access (base.c_str (), R_OK) != 0)
+    base = "/System/Library/dyld/dyld_shared_cache_arm64e";
+  darwin_dsc_parse (base, state, 0);
+  uint64_t slide = darwin_shcache_slide (state);
+
+  for (const auto &img : state.images)
+    {
+      if (strstr (img.second.c_str (), args) == nullptr)
+	continue;
+
+      gdb_printf (_("%s %s slide=%s\n"), hex_string (img.first),
+		  img.second.c_str (), hex_string (slide));
+      gdb_byte hdr[32];
+      if (target_read_memory (img.first + slide, hdr, sizeof (hdr)) != 0)
+	{
+	  gdb_printf (_("  cannot read header\n"));
+	  return;
+	}
+      uint32_t ncmds = dsc_u32 (hdr + 16);
+      uint32_t sizeofcmds = dsc_u32 (hdr + 20);
+      std::vector<gdb_byte> cmds (sizeofcmds);
+      if (sizeofcmds > (1u << 20)
+	  || target_read_memory (img.first + slide + 32, cmds.data (),
+				 sizeofcmds) != 0)
+	return;
+
+      size_t off = 0;
+      for (uint32_t i = 0; i < ncmds && off + 8 <= cmds.size (); i++)
+	{
+	  uint32_t cmd = dsc_u32 (&cmds[off]);
+	  uint32_t size = dsc_u32 (&cmds[off + 4]);
+	  if (size < 8 || off + size > cmds.size ())
+	    break;
+	  if (cmd == 0x19 && size >= 72)
+	    {
+	      uint32_t nsects = dsc_u32 (&cmds[off + 64]);
+	      size_t sp = off + 72;
+	      for (uint32_t k = 0; k < nsects && sp + 80 <= off + size; k++)
+		{
+		  char sect[17] = {}, seg[17] = {};
+		  memcpy (sect, &cmds[sp], 16);
+		  memcpy (seg, &cmds[sp + 16], 16);
+		  uint64_t a = dsc_u32 (&cmds[sp + 32])
+			       | ((uint64_t) dsc_u32 (&cmds[sp + 36]) << 32);
+		  uint64_t z = dsc_u32 (&cmds[sp + 40])
+			       | ((uint64_t) dsc_u32 (&cmds[sp + 44]) << 32);
+		  gdb_printf ("  %s,%s addr=%s size=%s\n", seg, sect,
+			      hex_string (a), hex_string (z));
+		  sp += 80;
+		}
+	    }
+	  off += size;
+	}
+      return;
+    }
+}
