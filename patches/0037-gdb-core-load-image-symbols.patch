+static bool
+darwin_cu_pc_is_code (CORE_ADDR pc)
+{
+  CORE_ADDR func;
+  uint32_t enc;
+  if (darwin_cu_for_pc (pc, &func, &enc))
+    return true;
+  try
+    {
+      struct obj_section *section = find_pc_section (pc);
+      if (section != nullptr
+	  && (section->the_bfd_section->flags & SEC_CODE) != 0)
+	return true;
+    }
+  catch (const gdb_exception_error &)
+    {
+    }
+  return false;
+}
+
+/* Last resort for a FRAMELESS frame whose LR was clobbered: look for a
+   plausible return address in the first 512 bytes above SP.  */
+
+static bool
+darwin_cu_scan_stack (CORE_ADDR sp, CORE_ADDR *pc, CORE_ADDR *next_sp)
+{
+  for (CORE_ADDR off = 8; off <= 512; off += 8)
+    {
+      CORE_ADDR candidate = 0;
+      if (target_read_memory (sp + off, (gdb_byte *) &candidate, 8) != 0)
+	break;
+      if (candidate < 0x100000000 || (candidate & 3) != 0)
+	continue;
+      if (!darwin_cu_pc_is_code (candidate))
+	continue;
+      /* A return address follows a branch-with-link.  */
+      uint32_t insn = 0;
+      if (target_read_memory (candidate - 4, (gdb_byte *) &insn, 4) != 0)
+	continue;
+      bool call = (insn & 0xfc000000) == 0x94000000
+		  || (insn & 0xfffffc1f) == 0xd63f0000;
+      if (!call)
+	continue;
+      *pc = candidate;
+      *next_sp = sp + off + 8;
+      return true;
+    }
+  return false;
+}
