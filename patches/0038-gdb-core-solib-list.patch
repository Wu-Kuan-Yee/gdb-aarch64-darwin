diff --git a/gdb/solib-darwin.c b/gdb/solib-darwin.c
index 341097da92b..8febd13120e 100644
--- a/gdb/solib-darwin.c
+++ b/gdb/solib-darwin.c
@@ -34,6 +34,24 @@
 #include "mach-o.h"
 #include "mach-o/external.h"
 
+/* Images recorded in a core file, used by current_sos when there is no
+   live dyld to interrogate.  */
+
+static std::vector<std::pair<CORE_ADDR, std::string>> darwin_core_images;
+
+void
+darwin_solib_set_core_images
+  (const std::vector<std::pair<CORE_ADDR, std::string>> &images)
+{
+  darwin_core_images = images;
+}
+
+void
+darwin_solib_clear_core_images ()
+{
+  darwin_core_images.clear ();
+}
+
 /* solib_ops for Darwin systems.  */
 
 struct darwin_solib_ops : public solib_ops
@@ -214,6 +232,21 @@ find_program_interpreter (void)
 owning_intrusive_list<solib>
 darwin_solib_ops::current_sos ()
 {
+  if (!darwin_core_images.empty ())
+    {
+      owning_intrusive_list<solib> sos;
+      const char *exec = current_program_space->exec_filename ();
+      for (const auto &image : darwin_core_images)
+	{
+	  if (image.second.empty () || (exec != nullptr
+					&& image.second == exec))
+	    continue;
+	  sos.emplace_back (std::make_unique<lm_info_darwin> (image.first),
+			    image.second, image.second, *this);
+	}
+      return sos;
+    }
+
   type *ptr_type
     = builtin_type (current_inferior ()->arch ())->builtin_data_ptr;
   enum bfd_endian byte_order = type_byte_order (ptr_type);
