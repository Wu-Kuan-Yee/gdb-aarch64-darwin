+static void
+darwin_analyze_frameless_command (const char *args, int from_tty)
+{
+  unsigned long func = 0, pc = 0, stack = 0;
+  if (args == nullptr
+      || sscanf (args, "%lx %lx %lx", &func, &pc, &stack) != 3)
+    error (_("usage: darwin-analyze-frameless FUNC PC STACK-SIZE"));
+
+  CORE_ADDR sp = get_frame_register_unsigned (get_current_frame (),
+					      AARCH64_SP_REGNUM);
+  CORE_ADDR caller = 0, caller_sp = 0;
+  if (!darwin_cu_analyze_frameless (func, pc, sp + stack,
+				    &caller, &caller_sp))
+    {
+      gdb_printf (_("no saved LR found\n"));
+      return;
+    }
+  gdb_printf (_("caller pc=%s sp=%s\n"), hex_string (caller),
+	      hex_string (caller_sp));
+}
