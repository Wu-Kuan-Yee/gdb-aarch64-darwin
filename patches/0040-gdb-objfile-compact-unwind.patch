+static bool
+darwin_dsc_unwind_lookup (const darwin_dsc_state &state, uint64_t unslid,
+			  uint64_t slide, uint32_t *encoding,
+			  std::string *info, uint64_t *func_start = nullptr)
+{
+  uint64_t image_addr = 0;
+  std::string image_path;
+  for (const auto &img : state.images)
+    if (img.first <= unslid && unslid - img.first < (1ull << 30)
+	&& img.first >= image_addr)
+      {
+	image_addr = img.first;
+	image_path = img.second;
+      }
+  if (image_addr == 0)
+    return false;
+
+  uint64_t sec_addr = 0, sec_size = 0;
+  if (!darwin_dsc_find_unwind_section (state, image_addr, slide,
+				       &sec_addr, &sec_size)
+      || sec_size < 32 || sec_size > (16u << 20))
+    return false;
+
+  std::vector<gdb_byte> data (sec_size);
+  if (target_read_memory (sec_addr + slide, data.data (), sec_size) != 0)
+    return false;
+
+  uint32_t off = 0;
+  if (!darwin_compact_lookup_bytes (data.data (), data.size (),
+				    (uint32_t) (unslid - image_addr),
+				    encoding, &off))
+    return false;
+
+  if (func_start != nullptr)
+    *func_start = image_addr + off;
+  *info = string_printf ("%s func=%s", image_path.c_str (),
+			 hex_string (image_addr + off));
+  return true;
+}
