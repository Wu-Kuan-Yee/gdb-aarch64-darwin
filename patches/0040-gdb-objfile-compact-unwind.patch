+/* Look up a compact-unwind entry for a runtime PC in any Mach-O objfile.  */
+
+static bool
+darwin_objfile_unwind_lookup (CORE_ADDR pc, uint32_t *encoding,
+			      CORE_ADDR *func_start)
+{
+  struct obj_section *osect = find_pc_section (pc);
+  if (osect == nullptr || osect->objfile == nullptr)
+    return false;
+
+  bfd *abfd = osect->objfile->obfd.get ();
+  if (abfd == nullptr)
+    return false;
+
+  asection *unwind = nullptr;
+  for (asection *sect = abfd->sections; sect != nullptr; sect = sect->next)
+    {
+      const char *name = bfd_section_name (sect);
+      if (name != nullptr && strstr (name, "unwind_info") != nullptr)
+	{
+	  unwind = sect;
+	  break;
+	}
+    }
+  if (unwind == nullptr)
+    return false;
+
+  bfd_size_type usize = bfd_section_size (unwind);
+  if (usize < 32 || usize > (16u << 20))
+    return false;
+  std::vector<gdb_byte> data (usize);
+  if (!bfd_get_section_contents (abfd, unwind, data.data (), 0, usize))
+    return false;
+
+  gdb_byte hdr[32];
+  if (bfd_seek (abfd, 0, SEEK_SET) != 0
+      || bfd_read (hdr, sizeof (hdr), abfd) != (int) sizeof (hdr)
+      || dsc_u32 (hdr) != 0xfeedfacf)
+    return false;
+  uint32_t ncmds = dsc_u32 (hdr + 16);
+  uint32_t sizeofcmds = dsc_u32 (hdr + 20);
+  if (sizeofcmds > (1u << 20))
+    return false;
+  std::vector<gdb_byte> cmds (sizeofcmds);
+  if (sizeofcmds != 0
+      && (bfd_seek (abfd, 32, SEEK_SET) != 0
+	  || bfd_read (cmds.data (), sizeofcmds, abfd)
+	     != (int) sizeofcmds))
+    return false;
+
+  uint64_t text_vmaddr = UINT64_MAX;
+  size_t p = 0;
+  for (uint32_t i = 0; i < ncmds && p + 8 <= cmds.size (); i++)
+    {
+      uint32_t cmd = dsc_u32 (&cmds[p]);
+      uint32_t size = dsc_u32 (&cmds[p + 4]);
+      if (size < 8 || p + size > cmds.size ())
+	break;
+      if (cmd == 0x19 && size >= 72)
+	{
+	  char name[17] = {};
+	  memcpy (name, &cmds[p + 8], 16);
+	  if (strcmp (name, "__TEXT") == 0)
+	    {
+	      text_vmaddr = dsc_u32 (&cmds[p + 24])
+			    | ((uint64_t) dsc_u32 (&cmds[p + 28]) << 32);
+	      break;
+	    }
+	}
+      p += size;
+    }
+  if (text_vmaddr == UINT64_MAX)
+    return false;
+
+  asection *text = osect->the_bfd_section;
+  uint64_t sec_vma = bfd_section_vma (text);
+  int64_t slide = (int64_t) osect->addr () - (int64_t) sec_vma;
+  uint64_t image_runtime = text_vmaddr + slide;
+  if (pc < image_runtime)
+    return false;
+
+  uint32_t off = 0;
+  if (!darwin_compact_lookup_bytes (data.data (), data.size (),
+				    (uint32_t) (pc - image_runtime),
+				    encoding, &off))
+    return false;
+  *func_start = image_runtime + off;
+  return true;
+}
 
