+static void
+darwin_eh_normal_stop (struct bpstat *bs, int print_frame)
+{
+  if (darwin_pending_eh_file.empty ())
+    return;
+
+  std::string path = std::move (darwin_pending_eh_file);
+  uint64_t slide = darwin_pending_eh_slide;
+  darwin_pending_eh_file.clear ();
+  std::string command
+    = string_printf ("add-symbol-file %s -o 0x%lx", path.c_str (),
+		     (unsigned long) slide);
+  try
+    {
+      execute_command (command.c_str (), 0);
+    }
+  catch (const gdb_exception_error &ex)
+    {
+      warning (_("cannot load cache eh_frame: %s"), ex.what ());
+    }
+  unlink (path.c_str ());
+}
