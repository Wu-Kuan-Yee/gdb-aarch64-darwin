+
+/* Read the __TEXT,__eh_frame section of a cache image.  */
+
+static bool
+darwin_dsc_read_eh_frame (const darwin_dsc_state &state, uint64_t image_addr,
+			  std::vector<gdb_byte> &out, uint64_t &addr)
+{
+  std::string file;
+  uint64_t header_off;
+  if (!darwin_dsc_image_header (state, image_addr, file, header_off))
+    return false;
+
+  int fd = open (file.c_str (), O_RDONLY);
+  if (fd < 0)
+    return false;
+
+  gdb_byte hdr[32];
+  if (pread (fd, hdr, sizeof (hdr), header_off) != sizeof (hdr)
+      || dsc_u32 (hdr) != 0xfeedfacf)
+    {
+      close (fd);
+      return false;
+    }
+
+  uint32_t ncmds = dsc_u32 (hdr + 16);
+  uint32_t sizeofcmds = dsc_u32 (hdr + 20);
+  if (sizeofcmds > (1u << 20))
+    {
+      close (fd);
+      return false;
+    }
+  std::vector<gdb_byte> cmds (sizeofcmds);
+  if (sizeofcmds != 0
+      && pread (fd, cmds.data (), sizeofcmds, header_off + 32)
+	 != (ssize_t) sizeofcmds)
+    {
+      close (fd);
+      return false;
+    }
+
+  size_t off = 0;
+  for (uint32_t i = 0; i < ncmds && off + 8 <= cmds.size (); i++)
+    {
+      uint32_t cmd = dsc_u32 (&cmds[off]);
+      uint32_t size = dsc_u32 (&cmds[off + 4]);
+      if (size < 8 || off + size > cmds.size ())
+	break;
+      if (cmd == 0x19 && size >= 72)
+	{
+	  char seg[17] = {};
+	  memcpy (seg, &cmds[off + 8], 16);
+	  uint32_t nsects = dsc_u32 (&cmds[off + 64]);
+	  size_t sp = off + 72;
+	  for (uint32_t k = 0; k < nsects && sp + 80 <= off + size; k++)
+	    {
+	      char sect[17] = {};
+	      char segname[17] = {};
+	      memcpy (sect, &cmds[sp], 16);
+	      memcpy (segname, &cmds[sp + 16], 16);
+	      if (strcmp (segname, "__TEXT") == 0
+		  && strcmp (sect, "__eh_frame") == 0)
+		{
+		  uint64_t a = dsc_u32 (&cmds[sp + 32])
+			       | ((uint64_t) dsc_u32 (&cmds[sp + 36]) << 32);
+		  uint64_t sz = dsc_u32 (&cmds[sp + 40])
+				| ((uint64_t) dsc_u32 (&cmds[sp + 44]) << 32);
+		  uint64_t fo = dsc_u32 (&cmds[sp + 48]);
+		  if (sz == 0 || sz > (8u << 20) || a == 0)
+		    break;
+		  out.resize (sz);
+		  if (pread (fd, out.data (), sz, fo) != (ssize_t) sz)
+		    {
+		      out.clear ();
+		      break;
+		    }
+		  addr = a;
+		  close (fd);
+		  return true;
+		}
+	      sp += 80;
+	    }
+	}
+      off += size;
+    }
+  close (fd);
+  return false;
+}
+
+/* Emit a Mach-O with the cache images' __eh_frame sections and load it at
+   the runtime slide.  GDB then has DWARF CFI for compact-unwind mode 3.  */
+
+static void
+darwin_emit_eh_frames (const darwin_dsc_state &state, uint64_t slide,
+		       const std::set<std::string> &loaded_paths)
+{
+  struct eh_section
+  {
+    uint64_t addr;
+    std::vector<gdb_byte> data;
+  };
+  std::vector<eh_section> frames;
+  uint64_t total = 0;
+  for (const auto &img : state.images)
+    {
+      if (!loaded_paths.empty () && loaded_paths.count (img.second) == 0)
+	continue;
+      eh_section eh;
+      if (!darwin_dsc_read_eh_frame (state, img.first, eh.data, eh.addr))
+	continue;
+      if (total + eh.data.size () > (32u << 20))
+	break;
+      total += eh.data.size ();
+      frames.push_back (std::move (eh));
+    }
+  if (frames.empty ())
+    return;
+
+  const uint32_t seg_size = 72 + (uint32_t) (1 + frames.size ()) * 80;
+  const uint32_t link_size = 72;
+  const uint32_t cmds_size = seg_size + link_size + 24 + 24 + 80;
+  const uint32_t pad = 0x100;
+  uint64_t data_off = (32 + cmds_size + pad + 7) & ~(uint64_t) 7;
+  std::vector<uint64_t> offsets (frames.size ());
+  uint64_t cur = data_off;
+  for (size_t i = 0; i < frames.size (); i++)
+    {
+      offsets[i] = cur;
+      cur += frames[i].data.size () + 7;
+      cur &= ~(uint64_t) 7;
+    }
+  uint64_t symoff = cur;
+  std::string strtab (1, '\0');
+  const char *dummy = "__gdb_eh_frame";
+  strtab += dummy;
+  strtab.push_back ('\0');
+  std::vector<gdb_byte> nlist;
+  auto n32 = [&] (uint32_t v)
+    { nlist.push_back (v & 0xff); nlist.push_back ((v >> 8) & 0xff);
+      nlist.push_back ((v >> 16) & 0xff); nlist.push_back ((v >> 24) & 0xff); };
+  n32 (1);
+  nlist.push_back (0x0f);
+  nlist.push_back (1);
+  nlist.push_back (0); nlist.push_back (0);
+  n32 (0x80000000); n32 (0x1);	/* 0x180000000 */
+  uint64_t stroff = symoff + nlist.size ();
+  uint64_t total_size = stroff + strtab.size ();
+
+  std::vector<gdb_byte> out;
+  auto w32 = [&] (uint32_t v)
+    { out.push_back (v & 0xff); out.push_back ((v >> 8) & 0xff);
+      out.push_back ((v >> 16) & 0xff); out.push_back ((v >> 24) & 0xff); };
+  auto w64 = [&] (uint64_t v)
+    { w32 ((uint32_t) v); w32 ((uint32_t) (v >> 32)); };
+  auto wname = [&] (const char *s)
+    { for (int i = 0; i < 16; i++)
+	out.push_back (i < (int) strlen (s) ? s[i] : 0); };
+
+  w32 (0xfeedfacf); w32 (0x0100000c); w32 (0); w32 (2);
+  w32 (5); w32 (cmds_size); w32 (0); w32 (0);
+
+  w32 (0x19); w32 (seg_size); wname ("__TEXT");
+  w64 (0x180000000); w64 (0x200000000); w64 (0); w64 (total_size);
+  w32 (7); w32 (5); w32 (1 + frames.size ()); w32 (0);
+
+  wname ("__text"); wname ("__TEXT");
+  w64 (0x180000000); w64 (0x200000000); w32 (0); w32 (4);
+  w32 (0); w32 (0); w32 (1); w32 (0); w32 (0); w32 (0);
+
+  for (size_t i = 0; i < frames.size (); i++)
+    {
+      wname ("__eh_frame"); wname ("__TEXT");
+      w64 (frames[i].addr); w64 (frames[i].data.size ());
+      w32 (offsets[i]); w32 (3);
+      w32 (0); w32 (0); w32 (0); w32 (0); w32 (0); w32 (0);
+    }
+
+  w32 (0x19); w32 (link_size); wname ("__LINKEDIT");
+  w64 (0x300000000); w64 (nlist.size () + strtab.size ());
+  w64 (symoff); w64 (nlist.size () + strtab.size ());
+  w32 (7); w32 (1); w32 (0); w32 (0);
+  w32 (0x28); w32 (24); w64 (0); w64 (0);
+  w32 (2); w32 (24); w32 (symoff); w32 (1); w32 (stroff);
+  w32 (strtab.size ());
+  w32 (0xb); w32 (80);
+  for (int i = 0; i < 18; i++)
+    w32 (i == 3 ? 1 : 0);
+
+  out.insert (out.end (), pad, 0);
+  for (size_t i = 0; i < frames.size (); i++)
+    {
+      out.resize (offsets[i], 0);
+      out.insert (out.end (), frames[i].data.begin (), frames[i].data.end ());
+      while ((out.size () & 7) != 0)
+	out.push_back (0);
+    }
+  out.resize (symoff, 0);
+  out.insert (out.end (), nlist.begin (), nlist.end ());
+  out.insert (out.end (), strtab.begin (), strtab.end ());
+
+  char path[] = "/tmp/gdb-eh-XXXXXX";
+  int fd = mkstemp (path);
+  if (fd < 0)
+    return;
+  size_t done = 0;
+  while (done < out.size ())
+    {
+      ssize_t n = write (fd, out.data () + done, out.size () - done);
+      if (n <= 0)
+	{
+	  close (fd);
+	  unlink (path);
+	  return;
+	}
+      done += n;
+    }
+  close (fd);
+
+  if (!darwin_pending_eh_file.empty ())
+    unlink (darwin_pending_eh_file.c_str ());
+  darwin_pending_eh_file = path;
+  darwin_pending_eh_slide = slide;
+}
